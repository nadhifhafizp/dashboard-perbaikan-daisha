generator client {
  provider = "prisma-client-js"
  output   = "../lib/prisma-client"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL") // Otomatis mengarah ke file lokal
}

// ============================================================
// SISTEM 1: PERBAIKAN DAISHA (Eksisting — tidak dirombak)
// ============================================================

model MasterDaisha {
  noDaisha   String   @id
  namaDaisha String   
  ukuran     String   
  seksi      String   
  tickets    Ticket[] 
}

model Ticket {
  idTiket      String         @id 
  noDaisha     String
  daisha       MasterDaisha   @relation(fields: [noDaisha], references: [noDaisha])
  namaPelapor  String
  status       String         @default("Open") 
  waktuMasuk   DateTime       @default(now())
  waktuSelesai DateTime?
  catatan      String?
  details      TicketDetail[] 
}

model TicketDetail {
  idDetail   Int      @id @default(autoincrement())
  idTiket    String
  ticket     Ticket   @relation(fields: [idTiket], references: [idTiket])
  komponen   String   
  gejala     String   
  tindakan   String   
  qty        Int
}

model DaishaType {
  id         Int               @id @default(autoincrement())
  name       String            @unique
  seksi      String
  components DaishaComponent[]
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
}

model DaishaComponent {
  id           Int             @id @default(autoincrement())
  daishaTypeId Int
  daishaType   DaishaType      @relation(fields: [daishaTypeId], references: [id], onDelete: Cascade)
  name         String
  symptoms     DaishaSymptom[]

  @@unique([daishaTypeId, name])
}

model DaishaSymptom {
  id          Int             @id @default(autoincrement())
  componentId Int
  component   DaishaComponent @relation(fields: [componentId], references: [id], onDelete: Cascade)
  description String
}

// ============================================================
// SISTEM 2: FOLLOW-UP REQUEST ANTAR SEKSI
// ============================================================

model SectionRequest {
  id            Int       @id @default(autoincrement())
  nomorRequest  String    @unique          // Nomor unik: REQ-YYYYMMDD-XXX
  seksiPemohon  String                     // Nama seksi yang mengajukan
  picPemohon    String                     // Nama PIC yang mengajukan
  kontakPemohon String?                    // No Telp / Ext PIC
  namaBarang    String                     // Nama barang / jig / troli yang diminta
  spesifikasi   String?                    // Ukuran, material, detail teknis
  jumlah        Int       @default(1)
  satuan        String    @default("pcs")
  urgensi       String    @default("Normal") // Normal / Urgent / Critical
  catatan       String?                    // Catatan kebutuhan tambahan
  status        String    @default("Diajukan") // Diajukan, Disetujui, Dikerjakan, Selesai, Ditolak
  alasanTolak   String?                    // Alasan jika ditolak
  picBengkel    String?                    // Teknisi PIC bengkel yang mengerjakan
  estimasi      String?                    // Estimasi selesai (text bebas)
  catatanAdmin  String?                    // Catatan dari admin/bengkel
  dibuatOleh    String                     // username pembuat request
  waktuDibuat   DateTime  @default(now())
  waktuUpdate   DateTime  @updatedAt
  waktuSelesai  DateTime?
  materials     SectionRequestMaterial[]
}

model SectionRequestMaterial {
  id              Int            @id @default(autoincrement())
  sectionRequestId Int
  sectionRequest  SectionRequest @relation(fields: [sectionRequestId], references: [id], onDelete: Cascade)
  namaKomponen    String         // Nama sparepart / material yang dipakai
  sparepart       Sparepart      @relation(fields: [namaKomponen], references: [namaKomponen])
  qty             Int            @default(1)
  keterangan      String?
}

// ============================================================
// SISTEM 3: MANAJEMEN SPAREPARTS & MATERIAL (Penghubung)
// ============================================================

model Sparepart {
  namaKomponen String   @id 
  kategori     String   @default("Umum")   // Daisha, Fabrikasi, Umum
  stokGudang   Int      @default(0)
  satuan       String 
  minStok      Int      @default(0)        // Safety stock threshold
  lokasi       String?                     // Lokasi rak / gudang
  logs         SparepartLog[]
  requestMaterials SectionRequestMaterial[]
}

model SparepartLog {
  id            Int       @id @default(autoincrement())
  namaKomponen  String
  sparepart     Sparepart @relation(fields: [namaKomponen], references: [namaKomponen])
  tipe          String                     // IN = masuk (restock), OUT = keluar (pemakaian)
  qty           Int
  referensi     String?                    // ID tiket daisha / nomor request seksi / keterangan manual
  keterangan    String?
  tanggal       DateTime  @default(now())
}

// ============================================================
// AKUN PENGGUNA (Diperluas: + USER_SEKSI)
// ============================================================

model User {
  id          Int      @id @default(autoincrement())
  username    String   @unique
  password    String
  name        String
  role        String   @default("OPERATOR") // ADMIN, OPERATOR, USER_SEKSI
  seksi       String?                       // Wajib diisi jika role = USER_SEKSI
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}